{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aka.ms/sslz/schemas/deployment-execution-manifest.schema.json",
  "title": "SSLZ immutable deployment execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "generatedBy",
    "manifestDigest",
    "plan",
    "readinessEvidence",
    "execution",
    "artifacts",
    "preview",
    "commands",
    "validationCheckIds",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifestVersion": {
      "const": "1.0.0"
    },
    "generatedBy": {
      "const": "startup-deployment-integration.mjs"
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "digest",
        "artifactPath",
        "artifactDigest",
        "approvalExpiresAt"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "artifactPath": {
          "$ref": "#/$defs/generatedPath"
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "approvalExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "readinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "digest",
        "expiresAt",
        "topologyDecisionId",
        "topologyDecisionDigest",
        "topologyDecisionExpiresAt"
      ],
      "properties": {
        "version": {
          "const": "3.0.0"
        },
        "id": {
          "$ref": "#/$defs/reference"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "topologyDecisionId": {
          "$ref": "#/$defs/reference"
        },
        "topologyDecisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "topologyDecisionExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "provider",
        "environment",
        "regionRole",
        "tenantId",
        "subscriptionId",
        "scope",
        "region",
        "stateStoreId",
        "terraformAuthMode"
      ],
      "properties": {
        "operation": {
          "const": "platform-baseline.deploy"
        },
        "provider": {
          "enum": ["bicep", "terraform"]
        },
        "environment": {
          "enum": ["prod", "nonprod"]
        },
        "regionRole": {
          "const": "primary"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "subscriptionId": {
          "$ref": "#/$defs/uuid"
        },
        "scope": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "stateStoreId": {
          "$ref": "#/$defs/uuid"
        },
        "terraformAuthMode": {
          "enum": ["cli", "oidc", null]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "source", "savedPlan", "provenance", "planJson"],
      "properties": {
        "parameter": {
          "$ref": "#/$defs/fileArtifact"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "fileCount"],
          "properties": {
            "path": {
              "enum": ["infra/bicep", "infra/terraform"]
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "fileCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "savedPlan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        },
        "planJson": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedSummaryDigest",
        "source",
        "status",
        "changes",
        "rawOutputDigest",
        "terraformVersion",
        "terraformPlatform",
        "terraformExecutableDigest",
        "bicepAttestation",
        "terraformAttestation"
      ],
      "properties": {
        "reviewedSummaryDigest": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "const": "command"
        },
        "status": {
          "const": "succeeded"
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "modify", "remove"],
          "properties": {
            "create": {
              "type": "integer",
              "minimum": 0
            },
            "modify": {
              "type": "integer",
              "minimum": 0
            },
            "remove": {
              "const": 0
            }
          }
        },
        "rawOutputDigest": {
          "$ref": "#/$defs/digest"
        },
        "terraformVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "terraformPlatform": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+_[a-z0-9]+$"
        },
        "terraformExecutableDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "bicepAttestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "compiledTemplateDigest",
                "compiledParametersDigest",
                "notificationContactsDigest",
                "resourceGraphDigest"
              ],
              "properties": {
                "compiledTemplateDigest": {
                  "$ref": "#/$defs/digest"
                },
                "compiledParametersDigest": {
                  "$ref": "#/$defs/digest"
                },
                "notificationContactsDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceGraphDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        },
        "terraformAttestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configurationDigest",
                "plannedValuesDigest",
                "providerConfigurationDigest",
                "resourceChangesDigest",
                "resourceGraphDigest",
                "variablesDigest",
                "notificationContactsDigest",
                "backendDigest",
                "sourceDigest",
                "parameterDigest",
                "savedPlanDigest",
                "planJsonDigest",
                "provenanceDigest",
                "attestationDigest"
              ],
              "properties": {
                "configurationDigest": {
                  "$ref": "#/$defs/digest"
                },
                "plannedValuesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "providerConfigurationDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceChangesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceGraphDigest": {
                  "$ref": "#/$defs/digest"
                },
                "variablesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "notificationContactsDigest": {
                  "$ref": "#/$defs/digest"
                },
                "backendDigest": {
                  "$ref": "#/$defs/digest"
                },
                "sourceDigest": {
                  "$ref": "#/$defs/digest"
                },
                "parameterDigest": {
                  "$ref": "#/$defs/digest"
                },
                "savedPlanDigest": {
                  "$ref": "#/$defs/digest"
                },
                "planJsonDigest": {
                  "$ref": "#/$defs/digest"
                },
                "provenanceDigest": {
                  "$ref": "#/$defs/digest"
                },
                "attestationDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation", "deployment"],
      "properties": {
        "preparation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/command"
            }
          ]
        },
        "deployment": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "validationCheckIds": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^deployment\\.platform\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewWrites",
        "bicepMode",
        "terraformSavedPlanOnly",
        "secondaryRegionDeployment",
        "workloadDeployment",
        "rawOutputRetained",
        "personalDataRetained"
      ],
      "properties": {
        "previewWrites": {
          "const": 0
        },
        "bicepMode": {
          "enum": ["Incremental", null]
        },
        "terraformSavedPlanOnly": {
          "type": "boolean"
        },
        "secondaryRegionDeployment": {
          "const": false
        },
        "workloadDeployment": {
          "const": false
        },
        "rawOutputRetained": {
          "const": false
        },
        "personalDataRetained": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "generatedPath": {
      "type": "string",
      "pattern": "^\\.sslz/generated/[A-Za-z0-9._/-]+$"
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/generatedPath"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments"],
      "properties": {
        "executable": {
          "enum": ["az", "terraform"]
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
