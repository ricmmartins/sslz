{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aka.ms/sslz/schemas/deployment-execution-manifest.schema.json",
  "title": "SSLZ immutable deployment execution manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "generatedBy",
    "manifestDigest",
    "plan",
    "readinessEvidence",
    "regionalAttempt",
    "defenderWorkspacePlacement",
    "execution",
    "artifacts",
    "preview",
    "commands",
    "validationCheckIds",
    "safety"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "manifestVersion": {
      "const": "1.0.0"
    },
    "generatedBy": {
      "const": "startup-deployment-integration.mjs"
    },
    "manifestDigest": {
      "$ref": "#/$defs/digest"
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "digest",
        "artifactPath",
        "artifactDigest",
        "approvalExpiresAt"
      ],
      "properties": {
        "version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "artifactPath": {
          "$ref": "#/$defs/generatedPath"
        },
        "artifactDigest": {
          "$ref": "#/$defs/digest"
        },
        "approvalExpiresAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "readinessEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "digest",
        "expiresAt",
        "topologyDecisionId",
        "topologyDecisionDigest",
        "topologyDecisionExpiresAt",
        "postgresqlDecisionDigest",
        "postgresqlSelectedEvidenceDigest"
      ],
      "properties": {
        "version": {
          "const": "3.0.0"
        },
        "id": {
          "$ref": "#/$defs/reference"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "topologyDecisionId": {
          "$ref": "#/$defs/reference"
        },
        "topologyDecisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "topologyDecisionExpiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "postgresqlDecisionDigest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "postgresqlSelectedEvidenceDigest": {
          "oneOf": [
            { "$ref": "#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "regionalAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "chainId",
        "attemptId",
        "attemptNumber",
        "previousAttemptDigest",
        "originalRegion",
        "targetRegion",
        "cleanupEvidenceDigest",
        "safeSameRegionRetry",
        "previousAttemptKey",
        "previousTargetRegion",
        "previousBindings",
        "retiredPolicyAssignmentNames",
        "identityDigest",
        "attemptKey",
        "resourceSuffix",
        "deploymentName",
        "previewDeploymentName",
        "stateKey",
        "workspaceName",
        "artifactRoot",
        "policyIdentityLifecycle"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "chainId": { "$ref": "#/$defs/identifier" },
        "attemptId": { "$ref": "#/$defs/identifier" },
        "attemptNumber": { "type": "integer", "minimum": 1, "maximum": 99 },
        "previousAttemptDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "originalRegion": { "$ref": "#/$defs/region" },
        "targetRegion": { "$ref": "#/$defs/region" },
        "cleanupEvidenceDigest": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "safeSameRegionRetry": { "type": "boolean" },
        "previousAttemptKey": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "previousTargetRegion": {
          "oneOf": [{ "$ref": "#/$defs/region" }, { "type": "null" }]
        },
        "previousBindings": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "regionalEvidenceDigest",
                "planDigest",
                "artifactDigest",
                "manifestDigest",
                "approvalDigest"
              ],
              "properties": {
                "regionalEvidenceDigest": { "$ref": "#/$defs/digest" },
                "planDigest": { "$ref": "#/$defs/digest" },
                "artifactDigest": { "$ref": "#/$defs/digest" },
                "manifestDigest": { "$ref": "#/$defs/digest" },
                "approvalDigest": { "$ref": "#/$defs/digest" }
              }
            },
            { "type": "null" }
          ]
        },
        "retiredPolicyAssignmentNames": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "identityDigest": { "$ref": "#/$defs/digest" },
        "attemptKey": { "$ref": "#/$defs/identifier" },
        "resourceSuffix": { "type": "string", "pattern": "^(?:|-a[0-9]{2}-[a-z0-9]+-[0-9a-f]{10})$" },
        "deploymentName": { "$ref": "#/$defs/identifier" },
        "previewDeploymentName": { "$ref": "#/$defs/identifier" },
        "stateKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*\\.tfstate$" },
        "workspaceName": { "$ref": "#/$defs/identifier" },
        "artifactRoot": { "$ref": "#/$defs/generatedPath" },
        "policyIdentityLifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "locationBound", "mode", "reuseAcrossChangedRegion"],
          "properties": {
            "type": { "const": "SystemAssigned" },
            "locationBound": { "const": true },
            "mode": { "const": "cleanup-and-recreate" },
            "reuseAcrossChangedRegion": { "const": false }
          }
        }
      }
    },
    "defenderWorkspacePlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decisionId",
        "decisionDigest",
        "status",
        "placementMode",
        "workspaceRegion",
        "workspaceScopeDigest",
        "workspaceReferenceDigest",
        "policyEvidenceDigest",
        "policyEvidenceFreshness",
        "paidPlanSelectionDigest"
      ],
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "decisionDigest": {
          "$ref": "#/$defs/digest"
        },
        "status": {
          "enum": ["ready", "not-required"]
        },
        "placementMode": {
          "enum": ["new", "existing", "central-shared", "disabled"]
        },
        "workspaceRegion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceScopeDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "workspaceReferenceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "policyEvidenceDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "policyEvidenceFreshness": {
          "enum": ["current", "not-required"]
        },
        "paidPlanSelectionDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "provider",
        "environment",
        "regionRole",
        "tenantId",
        "subscriptionId",
        "scope",
        "region",
        "stateStoreId",
        "terraformAuthMode"
      ],
      "properties": {
        "operation": {
          "const": "platform-baseline.deploy"
        },
        "provider": {
          "enum": ["bicep", "terraform"]
        },
        "environment": {
          "enum": ["prod", "nonprod"]
        },
        "regionRole": {
          "const": "primary"
        },
        "tenantId": {
          "$ref": "#/$defs/uuid"
        },
        "subscriptionId": {
          "$ref": "#/$defs/uuid"
        },
        "scope": {
          "type": "string",
          "pattern": "^/subscriptions/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "region": {
          "type": "string",
          "pattern": "^[a-z0-9]+$"
        },
        "stateStoreId": {
          "$ref": "#/$defs/uuid"
        },
        "terraformAuthMode": {
          "enum": ["cli", "oidc", null]
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "source", "savedPlan", "provenance", "planJson"],
      "properties": {
        "parameter": {
          "$ref": "#/$defs/fileArtifact"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "digest", "fileCount"],
          "properties": {
            "path": {
              "enum": ["infra/bicep", "infra/terraform"]
            },
            "digest": {
              "$ref": "#/$defs/digest"
            },
            "fileCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "savedPlan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        },
        "planJson": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/fileArtifact"
            }
          ]
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewedSummaryDigest",
        "source",
        "status",
        "changes",
        "rawOutputDigest",
        "terraformVersion",
        "terraformPlatform",
        "terraformExecutableDigest",
        "bicepAttestation",
        "terraformAttestation"
      ],
      "properties": {
        "reviewedSummaryDigest": {
          "$ref": "#/$defs/digest"
        },
        "source": {
          "const": "command"
        },
        "status": {
          "const": "succeeded"
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["create", "modify", "remove"],
          "properties": {
            "create": {
              "type": "integer",
              "minimum": 0
            },
            "modify": {
              "type": "integer",
              "minimum": 0
            },
            "remove": {
              "const": 0
            }
          }
        },
        "rawOutputDigest": {
          "$ref": "#/$defs/digest"
        },
        "terraformVersion": {
          "type": ["string", "null"],
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "terraformPlatform": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9]+_[a-z0-9]+$"
        },
        "terraformExecutableDigest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/digest"
            }
          ]
        },
        "bicepAttestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "compiledTemplateDigest",
                "compiledParametersDigest",
                "notificationContactsDigest",
                "resourceGraphDigest"
              ],
              "properties": {
                "compiledTemplateDigest": {
                  "$ref": "#/$defs/digest"
                },
                "compiledParametersDigest": {
                  "$ref": "#/$defs/digest"
                },
                "notificationContactsDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceGraphDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        },
        "terraformAttestation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "configurationDigest",
                "plannedValuesDigest",
                "providerConfigurationDigest",
                "resourceChangesDigest",
                "resourceGraphDigest",
                "variablesDigest",
                "notificationContactsDigest",
                "backendDigest",
                "sourceDigest",
                "parameterDigest",
                "savedPlanDigest",
                "planJsonDigest",
                "provenanceDigest",
                "attestationDigest"
              ],
              "properties": {
                "configurationDigest": {
                  "$ref": "#/$defs/digest"
                },
                "plannedValuesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "providerConfigurationDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceChangesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "resourceGraphDigest": {
                  "$ref": "#/$defs/digest"
                },
                "variablesDigest": {
                  "$ref": "#/$defs/digest"
                },
                "notificationContactsDigest": {
                  "$ref": "#/$defs/digest"
                },
                "backendDigest": {
                  "$ref": "#/$defs/digest"
                },
                "sourceDigest": {
                  "$ref": "#/$defs/digest"
                },
                "parameterDigest": {
                  "$ref": "#/$defs/digest"
                },
                "savedPlanDigest": {
                  "$ref": "#/$defs/digest"
                },
                "planJsonDigest": {
                  "$ref": "#/$defs/digest"
                },
                "provenanceDigest": {
                  "$ref": "#/$defs/digest"
                },
                "attestationDigest": {
                  "$ref": "#/$defs/digest"
                }
              }
            }
          ]
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparation", "deployment"],
      "properties": {
        "preparation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/command"
            }
          ]
        },
        "deployment": {
          "$ref": "#/$defs/command"
        }
      }
    },
    "validationCheckIds": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^deployment\\.platform\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previewWrites",
        "bicepMode",
        "terraformSavedPlanOnly",
        "secondaryRegionDeployment",
        "workloadDeployment",
        "rawOutputRetained",
        "personalDataRetained"
      ],
      "properties": {
        "previewWrites": {
          "const": 0
        },
        "bicepMode": {
          "enum": ["Incremental", null]
        },
        "terraformSavedPlanOnly": {
          "type": "boolean"
        },
        "secondaryRegionDeployment": {
          "const": false
        },
        "workloadDeployment": {
          "const": false
        },
        "rawOutputRetained": {
          "const": false
        },
        "personalDataRetained": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,31}$"
    },
    "generatedPath": {
      "type": "string",
      "pattern": "^\\.sslz/generated/[A-Za-z0-9._/-]+$"
    },
    "fileArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {
          "$ref": "#/$defs/generatedPath"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments"],
      "properties": {
        "executable": {
          "enum": ["az", "terraform"]
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
