# ==============================================================================
# Copy this file to terraform.tfvars and fill in your values
# ==============================================================================

# REQUIRED — Your Azure subscription ID (UUID format)
subscription_id = "00000000-0000-0000-0000-000000000000"

# REQUIRED — Your company name (used in resource naming, e.g., rg-mycompany-prod-monitoring)
company_name = "mycompany"

# REQUIRED — Environment: "prod" or "nonprod"
environment = "prod"

# Azure region to deploy into (default: eastus2)
location = "eastus2"

# REQUIRED — Email addresses that receive budget alerts
budget_alert_emails = [
  "platform-team@mycompany.com",
  "cto@mycompany.com"
]

# REQUIRED — Email for Defender for Cloud security alerts
security_contact_email = "security@mycompany.com"

# Monthly budget in USD (default: 5000)
monthly_budget_amount = 5000

# Budget start date — leave empty to auto-set to the 1st of the current month.
# If you set this manually, it must be the first of a month (e.g., "2026-03-01T00:00:00Z").
# budget_start_date = "2026-03-01T00:00:00Z"

# Deploy VNet and networking resources (default: true)
deploy_networking = true

# VNet address space — leave empty to use defaults (prod: 10.0.0.0/16, nonprod: 10.1.0.0/16)
# vnet_address_prefix = "10.0.0.0/16"

# Service delegation for the app subnet.
# Use "Microsoft.Web/serverFarms" for App Service or "Microsoft.App/environments" for Container Apps.
# Default: "Microsoft.Web/serverFarms"
# app_subnet_delegation = "Microsoft.App/environments"

# Defender for Cloud plans — enable what you need
# Servers and Databases default to null (auto-enabled for prod, disabled for nonprod).
# Key Vault defaults to true (low cost, always worth enabling).
# enable_defender_for_servers    = true  # recommended for prod (~$15/server/month)
enable_defender_for_containers = false # set true if running AKS (~$7/vCPU/month)
# enable_defender_for_databases  = true  # recommended for prod (~$15/server/month)
# enable_defender_for_key_vault = true  # default: true, low cost (~$0.02/10K transactions)
enable_defender_for_storage = false # paid Defender for Storage V2 is explicit opt-in

# Restrict deployments to these Azure regions (defaults to [location] if omitted)
log_analytics_workspace_location = "eastus2"
# existing_log_analytics_workspace_id = "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-central-security/providers/Microsoft.OperationalInsights/workspaces/law-central"
# defender_workspace_association_managed_externally = false # true only for the non-owner environment in a shared subscription
# defender_workspace_shared_subscription = false # true when prod and nonprod use the same subscription
# allowed_locations = ["eastus2", "centralus"]

# Additional tags merged with defaults (environment, managedBy, project, team)
tags = {
  costCenter = "engineering"
}
